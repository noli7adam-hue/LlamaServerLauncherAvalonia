<UserControl x:Class="LlamaServerLauncher.Controls.HistoryTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="Button.field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.field:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter.history">
            <Setter Property="MaxWidth" Value="Infinity"/>
        </Style>
    </UserControl.Styles>
    <TextBox x:Name="InnerTextBox"
             TextWrapping="NoWrap">
        <TextBox.InnerRightContent>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ClearButton"
                        Classes="field"
                        ToolTip.Tip="{Binding Localized.Clear}"
                        AutomationProperties.Name="{Binding Localized.Clear}"
                        Click="ClearButton_Click">
                    <PathIcon Width="10" Height="10"
                              Data="M5.6 4.2 L12 10.6 L18.4 4.2 L19.8 5.6 L13.4 12 L19.8 18.4 L18.4 19.8 L12 13.4 L5.6 19.8 L4.2 18.4 L10.6 12 L4.2 5.6 Z"/>
                </Button>
                <Button x:Name="HistoryButton"
                        Classes="field"
                        Click="HistoryButton_Click">
                    <PathIcon Width="10" Height="10"
                              Data="m1619 552l-742 741q-19 19-45 19t-45-19L45 552q-19-19-19-45.5T45 461l166-165q19-19 45-19t45 19l531 531l531-531q19-19 45-19t45 19l166 165q19 19 19 45.5t-19 45.5"/>
                </Button>
            </StackPanel>
        </TextBox.InnerRightContent>
    </TextBox>
</UserControl>
